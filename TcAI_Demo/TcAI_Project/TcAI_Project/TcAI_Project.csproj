<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.8 for best COM interop compatibility with TwinCAT AI -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>TcAI_Project</AssemblyName>
    <RootNamespace>TcAI_Project</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Visual Studio DTE COM automation — provides the EnvDTE namespace used
         to drive TcXaeShell (and Visual Studio) via the automation interface. -->
    <PackageReference Include="EnvDTE" Version="16.7.30328.74" />
    <!-- Required for the 'dynamic' keyword in SDK-style .NET Framework projects.
         Without this, CS0656 is thrown at the systemManager dynamic dispatch. -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

</Project>
